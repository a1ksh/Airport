<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" style="@style/Column" android:layout_width="0dp" android:layout_weight="1" android:gravity="center_horizontal" android:paddingHorizontal="2dp" android:paddingBottom="16dp">
    <Button android:id="@+id/stamp_button" style="@style/Secondary" android:layout_width="80dp" android:layout_height="80dp" android:minWidth="0dp" android:background="@drawable/passport_stamp" android:textSize="21sp" android:textStyle="bold" android:padding="0dp"/>
    <TextView android:id="@+id/stamp_city" style="@style/Heading" android:layout_width="match_parent" android:textSize="14sp" android:gravity="center" android:layout_marginTop="8dp"/>
    <TextView android:id="@+id/stamp_count" style="@style/Body" android:layout_width="match_parent" android:textSize="12sp" android:gravity="center" android:layout_marginTop="3dp"/>
</LinearLayout>
