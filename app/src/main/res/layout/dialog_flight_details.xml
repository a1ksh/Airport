<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" style="@style/Column" android:paddingHorizontal="22dp">
    <include layout="@layout/flight_route_fields" />
    <TextView android:id="@+id/flight_meta" style="@style/Body" android:layout_marginTop="13dp" />
    <TextView android:id="@+id/flight_badge" style="@style/Caption" android:background="@drawable/badge"
        android:paddingHorizontal="8dp" android:paddingVertical="5dp" android:layout_marginTop="9dp" android:layout_marginBottom="6dp" />
    <Button android:id="@+id/flight_weather" style="@style/Secondary" android:drawableStart="@drawable/service_weather"
        android:drawablePadding="6dp" android:layout_marginBottom="7dp" />
</LinearLayout>
