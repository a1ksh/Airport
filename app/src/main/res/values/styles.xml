<resources>
    <string name="app_name">Airport</string>
    <color name="sky">#F0F6FD</color>
    <color name="ink">#112B4C</color>
    <color name="muted">#48647E</color>
    <color name="blue">#1558C3</color>
    <color name="soft">#E5F0FC</color>
    <color name="line">#D8E6F4</color>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/blue</item>
        <item name="android:windowBackground">@color/sky</item>
        <item name="android:statusBarColor">@color/sky</item>
        <item name="android:navigationBarColor">@color/sky</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="Page">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>
    <style name="Column">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
    </style>
    <style name="Row" parent="Column">
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
    </style>
    <style name="Card" parent="Column">
        <item name="android:background">@drawable/card</item>
        <item name="android:padding">15dp</item>
        <item name="android:layout_marginTop">10dp</item>
    </style>
    <style name="Caption">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/blue</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.06</item>
    </style>
    <style name="Title" parent="Caption">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">28sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Heading" parent="Title">
        <item name="android:textSize">19sp</item>
    </style>
    <style name="Body" parent="Caption">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="Primary">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:background">@drawable/primary</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="Secondary" parent="Primary">
        <item name="android:background">@drawable/secondary</item>
        <item name="android:textColor">@color/blue</item>
    </style>
    <style name="Tile" parent="Secondary">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:background">@drawable/card</item>
        <item name="android:foreground">?android:attr/selectableItemBackground</item>
    </style>
    <style name="NavButton" parent="Tile">
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingHorizontal">4dp</item>
        <item name="android:paddingVertical">5dp</item>
        <item name="android:drawablePadding">2dp</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="AirportCode" parent="Title">
        <item name="android:textSize">26sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="IconButton" parent="Secondary">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textSize">20sp</item>
    </style>
    <style name="Section" parent="Heading">
        <item name="android:layout_marginTop">19dp</item>
        <item name="android:layout_marginBottom">7dp</item>
    </style>
    <style name="SettingsGroup" parent="Column">
        <item name="android:background">@drawable/card</item>
        <item name="android:paddingHorizontal">4dp</item>
        <item name="android:paddingVertical">2dp</item>
    </style>
    <style name="SettingsAction" parent="Secondary">
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="TripCheck">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingVertical">5dp</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="DashboardTab" parent="NavButton">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="ServiceButton" parent="SettingsAction">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:paddingHorizontal">7dp</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="Field">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">10dp</item>
        <item name="android:background">@drawable/field</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:textSize">15sp</item>
        <item name="android:layout_marginTop">9dp</item>
    </style>
</resources>
