<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" style="@style/Card" android:layout_marginTop="0dp" android:foreground="?android:attr/selectableItemBackground" android:orientation="vertical">
    <LinearLayout style="@style/Row" android:orientation="horizontal" android:baselineAligned="false">
        <TextView android:id="@+id/row_tag" style="@style/Caption" android:layout_width="0dp" android:layout_weight="1" />
        <TextView android:id="@+id/row_badge" style="@style/Caption" android:background="@drawable/badge" />
    </LinearLayout>
    <TextView android:id="@+id/row_title" style="@style/Heading" android:layout_marginTop="5dp" />
    <TextView android:id="@+id/row_body" style="@style/Body" android:layout_marginTop="5dp" />
</LinearLayout>