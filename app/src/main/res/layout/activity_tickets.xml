<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/page_root" style="@style/Page" android:orientation="vertical">
    <LinearLayout style="@style/Row" android:orientation="horizontal" android:baselineAligned="false">
        <Button android:id="@+id/back" style="@style/Secondary" android:text="@string/activity_admin_back_text" android:layout_width="44dp" android:minWidth="44dp" android:contentDescription="@string/activity_admin_back_contentDescription" />
        <TextView style="@style/Heading" android:text="@string/activity_home_inbox_text" android:layout_marginStart="12dp" />
    </LinearLayout>
    <LinearLayout style="@style/Card" android:orientation="vertical">
        <TextView android:id="@+id/ticket_heading" style="@style/Heading" />
        <TextView android:id="@+id/ticket_hint" style="@style/Body" android:layout_marginTop="7dp" />
        <Button android:id="@+id/new_ticket" style="@style/Primary" android:text="@string/activity_tickets_new_ticket_text" android:layout_marginTop="9dp" />
    </LinearLayout>
    <TextView android:id="@+id/empty" style="@style/Body" android:text="@string/activity_tickets_empty_text" android:layout_marginTop="13dp" />
    <ListView android:id="@+id/ticket_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@android:color/transparent" android:dividerHeight="8dp" android:layout_marginTop="9dp" android:listSelector="@android:color/transparent" />
</LinearLayout>