<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shared_root" android:layout_width="match_parent"
    android:layout_height="match_parent" android:fitsSystemWindows="true"
    android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="16dp" android:paddingEnd="4dp" android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView android:id="@+id/shared_host" style="@style/Body"
            android:layout_width="0dp" android:layout_weight="1" android:maxLines="1"
            android:ellipsize="middle" android:textSize="13sp"/>
        <Button android:id="@+id/shared_settings" style="@style/Secondary"
            android:background="?android:attr/selectableItemBackground" android:layout_width="wrap_content"
            android:text="@string/shared_server"/>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <WebView android:id="@+id/shared_web" android:layout_width="match_parent" android:layout_height="match_parent"/>
        <LinearLayout android:id="@+id/shared_error" style="@style/Column" android:layout_gravity="center"
            android:layout_marginHorizontal="22dp" android:padding="20dp" android:visibility="gone"
            android:background="@drawable/card">
            <TextView android:id="@+id/shared_status_title" style="@style/Heading" android:text="@string/shared_server_offline"/>
            <TextView android:id="@+id/shared_status_detail" style="@style/Body" android:layout_marginTop="8dp" android:text="@string/shared_server_retry_help"/>
            <Button android:id="@+id/shared_retry" style="@style/Primary"
                android:layout_marginTop="16dp" android:text="@string/shared_server_retry"/>
        </LinearLayout>
        <ProgressBar android:id="@+id/shared_progress" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="3dp" android:indeterminate="true"/>
    </FrameLayout>
    <Button android:id="@+id/open_about" style="@style/Secondary"
        android:background="?android:attr/selectableItemBackground"
        android:text="@string/about_title"/>
</LinearLayout>
