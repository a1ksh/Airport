<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="true">
    <LinearLayout style="@style/Column" android:paddingHorizontal="18dp" android:paddingBottom="6dp">
        <LinearLayout style="@style/Column" android:background="@drawable/card" android:padding="14dp">
            <LinearLayout style="@style/Row" android:baselineAligned="false">
                <TextView style="@style/Caption" android:text="@string/demo_pass" android:layout_width="0dp" android:layout_weight="1" />
                <TextView android:id="@+id/booking_info" style="@style/Caption" />
            </LinearLayout>
            <include layout="@layout/flight_route_fields" />
            <TextView android:id="@+id/booking_when" style="@style/Body" android:layout_marginTop="12dp" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" android:layout_marginTop="12dp" />
            <ImageView android:id="@+id/qr" android:layout_width="154dp" android:layout_height="154dp"
                android:layout_gravity="center_horizontal" android:layout_marginTop="4dp"
                android:contentDescription="@string/dialog_booking_qr_contentDescription" />
            <TextView android:id="@+id/booking_code" style="@style/Heading" android:layout_gravity="center_horizontal" />
            <TextView android:id="@+id/booking_status" style="@style/Body" android:layout_gravity="center_horizontal" android:layout_marginTop="5dp" />
        </LinearLayout>
        <Button android:id="@+id/prepare_trip" style="@style/Secondary" android:text="@string/trip_preparation"
            android:drawableStart="@drawable/service_guide" android:layout_marginTop="8dp" />
        <Button android:id="@+id/share_booking" style="@style/Secondary" android:text="@string/share_booking"
            android:layout_marginTop="8dp" />
    </LinearLayout>
</ScrollView>
