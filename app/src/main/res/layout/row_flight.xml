<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" style="@style/Column"
    android:background="@drawable/card" android:foreground="?android:attr/selectableItemBackground" android:padding="14dp">
    <LinearLayout style="@style/Row" android:baselineAligned="false">
        <TextView android:id="@+id/flight_number" style="@style/Caption" android:layout_width="0dp" android:layout_weight="1" />
        <TextView android:id="@+id/flight_badge" style="@style/Caption" android:letterSpacing="0"
            android:background="@drawable/badge" android:paddingHorizontal="9dp" android:paddingVertical="5dp" />
    </LinearLayout>
    <include layout="@layout/flight_route_fields" />
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line"
        android:layout_marginTop="10dp" android:layout_marginBottom="9dp" />
    <TextView android:id="@+id/flight_meta" style="@style/Body" />
</LinearLayout>
