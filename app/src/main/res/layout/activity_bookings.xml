<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/page_root" style="@style/Page" android:orientation="vertical">
    <LinearLayout style="@style/Row" android:orientation="horizontal" android:baselineAligned="false">
        <Button android:id="@+id/back" style="@style/Secondary" android:text="@string/activity_admin_back_text" android:layout_width="44dp" android:minWidth="44dp" android:contentDescription="@string/activity_admin_back_contentDescription" />
        <TextView style="@style/Title" android:text="@string/bookings_text" android:layout_marginStart="12dp" />
    </LinearLayout>
    <LinearLayout style="@style/Row" android:baselineAligned="false" android:layout_marginTop="13dp">
        <Button android:id="@+id/upcoming_trips" style="@style/NavButton"
            android:text="@string/trip_upcoming" android:layout_marginEnd="8dp" />
        <Button android:id="@+id/past_trips" style="@style/NavButton" android:text="@string/trip_archive" />
    </LinearLayout>
    <TextView android:id="@+id/empty" style="@style/Body" android:text="@string/activity_bookings_empty_text" android:layout_marginTop="13dp" />
    <Button android:id="@+id/find_trip" style="@style/Secondary" android:layout_marginTop="8dp"
        android:text="@string/lint_ui_find_flight" android:visibility="gone" />
    <ListView android:id="@+id/booking_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@android:color/transparent" android:dividerHeight="8dp" android:layout_marginTop="9dp" android:listSelector="@android:color/transparent" />
</LinearLayout>
