<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout style="@style/Column" android:paddingHorizontal="22dp" android:paddingBottom="8dp">
        <EditText android:id="@+id/current_password" style="@style/Field" android:hint="@string/password_current" android:autofillHints="password"
            android:inputType="textPassword" android:singleLine="true" android:maxLength="80" />
        <EditText android:id="@+id/new_password" style="@style/Field" android:hint="@string/password_new" android:autofillHints="newPassword"
            android:inputType="textPassword" android:singleLine="true" android:maxLength="80" />
        <EditText android:id="@+id/repeat_password" style="@style/Field" android:hint="@string/password_repeat" android:autofillHints="newPassword"
            android:inputType="textPassword" android:singleLine="true" android:maxLength="80" />
    </LinearLayout>
</ScrollView>
