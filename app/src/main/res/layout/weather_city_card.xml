<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" style="@style/Card"
    android:layout_width="0dp" android:layout_weight="1" android:layout_marginTop="0dp" android:padding="12dp">
    <TextView android:id="@+id/weather_city_name" style="@style/Heading" android:textSize="17sp" />
    <TextView android:id="@+id/weather_country" style="@style/Body" android:textSize="12sp" />
    <TextView android:id="@+id/degree" style="@style/Title" android:text="@string/activity_weather_degree_text" android:textSize="36sp" android:layout_marginTop="5dp" />
    <TextView android:id="@+id/condition" style="@style/Body" android:textSize="13sp" />
    <TextView android:id="@+id/weather_detail" style="@style/Body" android:textSize="12sp" android:layout_marginTop="5dp" />
    <TextView android:id="@+id/weather_time" style="@style/Body" android:textSize="11sp" android:layout_marginTop="5dp" />
</LinearLayout>
