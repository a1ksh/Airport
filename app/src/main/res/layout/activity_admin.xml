<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/page_root" style="@style/Page" android:orientation="vertical">
    <LinearLayout style="@style/Row" android:orientation="horizontal" android:baselineAligned="false">
        <Button android:id="@+id/back" style="@style/Secondary" android:text="@string/activity_admin_back_text" android:layout_width="44dp" android:minWidth="44dp" android:contentDescription="@string/activity_admin_back_contentDescription" />
        <TextView style="@style/Title" android:text="@string/admin_text" android:layout_marginStart="12dp" />
    </LinearLayout>
    <Button android:id="@+id/add_operator" style="@style/Primary" android:text="@string/lint_ui_operator_add" android:layout_marginTop="9dp" />
    <EditText android:id="@+id/account_search" style="@style/Field" android:hint="@string/lint_ui_account_search" android:importantForAutofill="no"
        android:inputType="text" android:singleLine="true" android:imeOptions="actionSearch" />
    <Button android:id="@+id/account_filter" style="@style/Secondary" android:text="@string/lint_ui_account_all_roles"
        android:layout_marginTop="8dp" />
    <TextView android:id="@+id/account_empty" style="@style/Body" android:text="@string/lint_ui_account_none"
        android:layout_marginTop="12dp" android:visibility="gone" />
    <LinearLayout style="@style/Card" android:orientation="vertical">
        <TextView android:id="@+id/stats" style="@style/Heading" />
        <TextView style="@style/Body" android:text="@string/admin_text2" android:layout_marginTop="7dp" />
    </LinearLayout>
    <ListView android:id="@+id/account_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@android:color/transparent" android:dividerHeight="8dp" android:layout_marginTop="9dp" android:listSelector="@android:color/transparent" />
</LinearLayout>
