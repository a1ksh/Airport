<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="true">
    <LinearLayout style="@style/Column" android:paddingHorizontal="16dp" android:paddingBottom="10dp">
        <TextView style="@style/Body" android:text="@string/seat_legend" android:layout_marginTop="6dp" android:layout_marginBottom="10dp" />
        <LinearLayout android:id="@+id/seat_rows" style="@style/Column" />
        <TextView android:id="@+id/seat_selection" style="@style/Caption" android:layout_marginTop="9dp"
            android:accessibilityLiveRegion="polite" />
    </LinearLayout>
</ScrollView>
