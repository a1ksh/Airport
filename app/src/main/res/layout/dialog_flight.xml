<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout style="@style/Column" android:padding="18dp" android:orientation="vertical">
        <EditText android:id="@+id/flight_code" style="@style/Field" android:hint="@string/dialog_flight_number_hint" android:importantForAutofill="no" android:inputType="textCapCharacters" android:maxLength="12" />
        <EditText android:id="@+id/city" style="@style/Field" android:hint="@string/dialog_flight_city_hint" android:importantForAutofill="no" android:inputType="textCapWords" android:maxLength="45" />
        <EditText android:id="@+id/gate" style="@style/Field" android:hint="@string/dialog_flight_gate_hint" android:importantForAutofill="no" android:inputType="textCapCharacters" android:maxLength="8" />
        <Button android:id="@+id/time" style="@style/Secondary" android:text="@string/dialog_flight_time_text" android:layout_marginTop="8dp" />
        <Spinner android:id="@+id/direction" android:layout_width="match_parent" android:layout_height="48dp" />
        <Spinner android:id="@+id/flight_status" android:layout_width="match_parent" android:layout_height="48dp" />
    </LinearLayout>
</ScrollView>
