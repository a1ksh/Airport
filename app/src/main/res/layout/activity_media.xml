<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/page_root" style="@style/Page" android:orientation="vertical" android:baselineAligned="false">
    <LinearLayout style="@style/Row" android:baselineAligned="false">
        <Button android:id="@+id/back" style="@style/IconButton" android:text="@string/activity_admin_back_text"
            android:contentDescription="@string/activity_admin_back_contentDescription" />
        <TextView style="@style/Title" android:text="@string/media_title" android:textSize="25sp" android:layout_marginStart="10dp" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false">
        <LinearLayout style="@style/Column" android:paddingBottom="12dp">
            <LinearLayout style="@style/Row" android:background="@drawable/route_banner" android:layout_marginTop="12dp"
                android:padding="12dp" android:baselineAligned="false">
                <kz.edu.airportcourse.ui.TravelSkyView android:layout_width="100dp" android:layout_height="100dp"
                    android:contentDescription="@string/media_globe" />
                <LinearLayout style="@style/Column" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="10dp">
                    <TextView style="@style/Heading" android:text="@string/media_journey" android:textColor="#FFFFFF" />
                    <TextView style="@style/Body" android:text="@string/media_description" android:textColor="#D5E8FC" android:layout_marginTop="6dp" />
                </LinearLayout>
            </LinearLayout>
            <TextView style="@style/Section" android:text="@string/media_choose" />
            <Spinner android:id="@+id/media_selector" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="48dp" android:background="@drawable/field" android:paddingHorizontal="8dp"
                android:contentDescription="@string/media_choose" />
            <TextView android:id="@+id/media_title" style="@style/Heading" android:layout_marginTop="14dp" android:layout_marginBottom="8dp" />
            <FrameLayout android:layout_width="match_parent" android:layout_height="210dp" android:background="#07152A">
                <VideoView android:id="@+id/video_player" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:layout_gravity="center" android:contentDescription="@string/media_player" />
            </FrameLayout>
            <TextView android:id="@+id/media_status" style="@style/Body" android:layout_marginTop="8dp" android:accessibilityLiveRegion="polite" />
            <LinearLayout style="@style/Row" android:baselineAligned="false" android:layout_marginTop="10dp">
                <Button android:id="@+id/media_play" style="@style/Tile" android:text="@string/media_play" />
                <Button android:id="@+id/media_pause" style="@style/Tile" android:text="@string/media_pause" android:layout_marginStart="6dp" />
                <Button android:id="@+id/media_stop" style="@style/Tile" android:text="@string/media_stop" android:layout_marginStart="6dp" />
            </LinearLayout>
            <TextView style="@style/Body" android:text="@string/media_controls_hint" android:layout_marginTop="12dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
