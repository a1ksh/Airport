<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/travel_hero" android:layout_width="match_parent" android:layout_height="174dp"
    android:background="@drawable/route_banner">
    <ImageView android:id="@+id/travel_photo" android:layout_width="match_parent"
        android:layout_height="match_parent" android:src="@drawable/airport_login_banner"
        android:scaleType="centerCrop" android:contentDescription="@null" />
    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/travel_scrim" />
    <LinearLayout style="@style/Column" android:layout_gravity="center_vertical" android:padding="20dp">
        <TextView style="@style/Caption" android:text="@string/home_text" android:textColor="#CCE5FF" />
        <TextView style="@style/Title" android:text="@string/app_name" android:textColor="#FFFFFF"
            android:textSize="42sp" android:layout_marginTop="4dp" />
        <TextView style="@style/Body" android:text="@string/travel_tagline" android:textColor="#E5F0FF" />
    </LinearLayout>
</FrameLayout>
