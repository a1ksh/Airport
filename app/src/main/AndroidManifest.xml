<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>
    <application android:theme="@style/AppTheme" android:label="@string/app_name"
        android:icon="@drawable/airport_icon" android:allowBackup="false" android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_rules" android:supportsRtl="false">
        <activity android:name=".ui.AboutActivity" android:exported="false"/>
        <activity android:name=".ui.RouteMapActivity" android:exported="false"/>
        <activity android:name=".ui.PassportActivity" android:exported="false"/>
        <activity android:name=".ui.MediaActivity" android:exported="false"/>
        <activity android:name=".ui.ReviewsActivity" android:exported="false" android:windowSoftInputMode="adjustResize"/>
        <activity android:name=".ui.ProfileActivity" android:exported="false" android:windowSoftInputMode="adjustResize"/>
        <activity android:name=".ui.StaffListActivity" android:exported="false"/>
        <activity android:name=".ui.NoticesActivity" android:exported="false"/>
        <activity android:name=".ui.WeatherActivity" android:exported="false"/>
        <activity android:name=".ui.BookingsActivity" android:exported="false"/>
        <activity android:name=".ui.AdminActivity" android:exported="false"/>
        <activity android:name=".ui.ChatActivity" android:exported="false" android:windowSoftInputMode="adjustResize"/>
        <activity android:name=".ui.TicketsActivity" android:exported="false"/>
        <activity android:name=".ui.FlightsActivity" android:exported="false"/>
        <activity android:name=".ui.HomeActivity" android:exported="false"/>
        <activity android:name=".ui.LoginActivity" android:exported="false" android:windowSoftInputMode="adjustResize"/>
        <activity android:name=".ui.SharedAirportActivity" android:exported="true"
            tools:targetApi="tiramisu"
            android:enableOnBackInvokedCallback="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
